# Copy to .env for local development; on Hostinger set these as environment variables.

# Hostinger email SMTP: smtp.hostinger.com, port 465
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@glassgeek-slidingdoorfl.com
SMTP_PASS=
# Optional: defaults to SMTP_USER
SMTP_FROM=
# Where quote requests are sent; defaults to SMTP_USER
QUOTE_TO_EMAIL=
