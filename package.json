{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "main": "apps/server/index.js",
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/server\"",
    "build": "npm run build --prefix apps/web",
    "start": "node apps/server/index.js",
    "preview": "npm run start",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "knip": "^6.32.1"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ]
}
